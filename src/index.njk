---
layout: base.njk
---
<div class="hero">
  <h1 class="hero__title">{{ uicopy.siteName }}</h1>
  <p class="hero__tagline">{{ uicopy.tagline }}</p>
</div>
<section aria-labelledby="latest-heading">
  <h2 class="section-title" id="latest-heading">{{ uicopy.latestHeading }}</h2>
  <ul class="post-list">
    {% for post in collections.posts | reverse %}
    {% if loop.index <= 3 %}
    <li>
      <time class="post-meta" datetime="{{ post.date.toISOString() }}">{{ post.date | dateJa }}</time>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="chip chip--proofread">{{ uicopy.badgeProofread }}</span>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</section>
