<!doctype html>
<html lang="{{ uicopy.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }}｜{{ uicopy.siteName }}{% else %}{{ uicopy.siteName }}｜{{ uicopy.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or uicopy.description }}">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/chip-state.css">
  <link rel="alternate" type="application/atom+xml" title="{{ uicopy.siteName }}" href="{{ site.url }}/feed.xml">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:title" content="{% if title %}{{ title }}｜{{ uicopy.siteName }}{% else %}{{ uicopy.siteName }}｜{{ uicopy.tagline }}{% endif %}">
  <meta property="og:description" content="{{ description or uicopy.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
</head>
<body>
  <a class="skip-link" href="#main">{{ uicopy.skipToContent }}</a>
  <header class="site-header">
    <div class="container site-header__inner">
      <p class="brand"><span class="brand__seal" aria-hidden="true">徒</span><span class="brand__name">{{ uicopy.siteName }}</span></p>
      <nav class="site-nav" aria-label="グローバルナビゲーション">
        <ul class="site-nav__list">
          {% for item in uicopy.nav %}
          <li><a href="{{ item.path }}" {% if page.url == item.path %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="container">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="container">
      <hr class="rule">
      <p class="site-footer__links">
        <a href="/feed.xml">{{ uicopy.footerFeed }}</a>
        <a href="/sitemap.xml">{{ uicopy.footerSitemap }}</a>
      </p>
      <p class="site-footer__copy"><small>{{ uicopy.copyright }}</small></p>
    </div>
  </footer>
</body>
</html>
